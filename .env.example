# Where the queue, denylist and media live. Default: ./data/x (gitignored).
# Point it at data/example/x to try the sample queue.
X_DATA_DIR=
# IANA time zone for posting slots (8:30, 12:30, 17:30). Default: America/Chicago.
X_TZ=
# Optional: a local dashboard behind a cookie gate that capture/capture.mjs should screenshot.
# Pages on this origin get the cookie below; other URLs are captured without it.
DASHBOARD_URL=
# Name and value of that dashboard's session cookie.
DASHBOARD_COOKIE_NAME=
DASHBOARD_KEY=
